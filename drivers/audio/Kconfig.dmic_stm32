config AUDIO_DMIC_STM32_DFSDM
	bool "STM32 DFSDM DMIC driver"
	default y
	depends on DT_HAS_ST_STM32_DFSDM_ENABLED && DT_HAS_ST_STM32_DFSDM_DMIC_ENABLED
	select USE_STM32_HAL_DFSDM
	select RESET
	select PINCTRL
	help
	  Enable support for STM32 DMIC driver.

if AUDIO_DMIC_STM32_DFSDM

config DMIC_STM32_DFSDM_MAX_SAMPLES
	int "Maximum number of samples per DMIC block"
	default 1024
	help
	  This defines the size of the static internal DMA buffer used for continuous
	  audio transfers. The driver allocates two of these blocks (Ping/Pong) per
	  active filter. Larger values allow for larger k_mem_slab block sizes but
	  consume more RAM.

endif # AUDIO_DMIC_STM32_DFSDM

config AUDIO_DMIC_STM32_MDF
	bool "STM32 MDF DMIC driver"
	default y
	depends on DT_HAS_ST_STM32_MDF_ENABLED
	select USE_STM32_HAL_MDF
	select RESET
	select PINCTRL
	help
	  Enable support for STM32 DMIC driver.

if AUDIO_DMIC_STM32_MDF

config DMIC_STM32_MDF_DELAY
	int "DMIC delay"
	default 0
	range 0 255
	help
	   Delay to apply on data source in number of samples.

config DMIC_STM32_MDF_DISCARD_SAMPLES
	int "DMIC discarded samples"
	default 0
	range 0 255
	help
	  Number of samples to be discarded every time the filter is
	  re-started.


config DMIC_STM32_MDF_DMA
	bool "STM32 MCU MDF DMA Support"
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_ST_STM32_MDF),dmas)
	select DMA
	#select CACHE_MANAGEMENT if DCACHE
	help
	  Enable the MDF DMA mode for MDF instances
	  that enable dma channels in the device tree node of their filters.

#config SPI_STM32_DMA_CACHED_MEMORY
#	bool "DMA transfers with buffers in cacheable memory (STM32U5)"
#	default y
#	depends on SPI_STM32_DMA && DCACHE && !SPI_RTIO
#	depends on SOC_SERIES_STM32U5X
#	help
#	  Let the DMA move buffers placed in cacheable memory, for example
#	  external PSRAM behind the DCACHE, instead of falling back to the
#	  interrupt or polling mode for them. An RX buffer in cacheable memory
#	  goes to the DMA only if its start and length are multiples of the
#	  data cache line size; a transfer with any other RX buffer in cacheable
#	  memory still uses the fallback.

endif # AUDIO_DMIC_STM32_MDF

config AUDIO_DMIC_STM32_QUEUE_SIZE
	int "DMIC message queue size"
	default 8
	depends on AUDIO_DMIC_STM32_DFSDM || AUDIO_DMIC_STM32_MDF
	help
	  Number of pending audio buffer messages that can be queued. Higher
	  values mean more buffering and audio data, but more RAM footprint.
	  Lower values mean less memory footprint and latency, but possibly
	  more overruns. This option is common for all STM32 DMIC drivers.
