/ {
	aliases {
		dmic0 = &pdm0;
	};
};

/*
 * MDF1:
 * PLL3_P selected as input audio clock.
 *
 * f_PLL3_p = 280 MHz (48 MHz * 105 / (18 * 1))
 */
&pll3 {
	div-m = <18>;
	mul-n = <105>;
	div-p = <1>;
	div-q = <1>;
	div-r = <1>;
	clocks = <&clk_hse>;
	status = "okay";
};

&mdf1 {
	clocks = <&rcc STM32_CLOCK(AHB1, 16)>,
		<&rcc STM32_SRC_PLL3_P MDF1_SEL(2)>;
	clock-names = "pclk", "aclk";
	status = "okay";

	pdm0: filter@50025080 {
		pinctrl-0 = <&mdf1_cck0_pf9
			     &mdf1_sdi0_pe8>;
		pinctrl-names = "default";
		filter-order = <4>;
		st,reshape-filter-decimation = <4>;
		st,highpass-filter-cutoff = <0>;
		status = "okay";
	};
};
